/* ============================================================
   Extraits SCSS à ajouter à la FIN de pointage-scan.component.scss
   (styles du bloc « Motif de sortie » — n'écrase rien d'existant)
   ============================================================ */

.motif-card {
  margin-bottom: 1rem;

  h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
  }

  .sub {
    margin: 0 0 0.75rem;
    color: var(--muted, #6b7280);
    font-size: 0.9rem;
  }
}

.motif-options {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.motif-chip {
  display: inline-flex;
  align-items: center;
  padding: 0.4rem 0.75rem;
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 999px;
  background: var(--surface, #fff);
  cursor: pointer;
  font-size: 0.875rem;
  transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;

  input {
    /* Le chip lui-même joue le rôle de bouton radio visuel. */
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  &:hover {
    border-color: var(--accent, #2563eb);
  }

  &.active {
    background: var(--accent, #2563eb);
    border-color: var(--accent, #2563eb);
    color: #fff;
  }
}
